{
  "name": "template-dev-gs",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script starter with safe push and configurable spreadsheet settings",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "login": "clasp login",
    "push": "node tools/safe-push.cjs",
    "push:check": "node tools/safe-push.cjs --dry-run",
    "push:local-check": "node tools/safe-push.cjs --local-check",
    "push:test": "node tools/safe-push.cjs --project .clasp.test.json",
    "push:prod": "node tools/safe-push.cjs --project .clasp.prod.json",
    "pull": "clasp pull",
    "open": "clasp open-script",
    "open:test": "clasp open-script -P .clasp.test.json",
    "open:prod": "clasp open-script -P .clasp.prod.json",
    "status": "clasp show-file-status"
  },
  "devDependencies": { "@google/clasp": "3.4.1" }
}
